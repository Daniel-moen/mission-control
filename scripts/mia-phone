#!/usr/bin/env python3
"""mia-phone: Mia phones Daniel (task 0621). Called as `mia call …` or directly.

  mia call "<why you are calling>" [--urgent] [--reason "<background>"] [--to +27…] [--twilio]
                                   ring Daniel (FaceTime Audio from this Mac; --twilio: the
                                   phone network, if Twilio is set up); prints the call id
  mia call-say <call_id> "<text>" [--hangup]
                                   say this in the live call (your answer to a
                                   "(phone) …" message); --hangup: then say goodbye
  mia call-hangup <call_id>        end the call now
  mia call-status [--json]         configured?, live call, recent calls, limits
  mia-phone incoming --from "<caller as FaceTime shows it>"
                                   (used by MiaCall --listen, task 0636) Daniel is FaceTiming
                                   Mia: checks the caller, opens the call on the relay and
                                   prints JSON {ok,id,key,relay} | {ok:false,ignore:true} (let
                                   it ring) | {ok:false,line:"…"} (answer, say it, hang up)

The call: Daniel's iPhone rings with a FaceTime Audio call from Mia's Apple ID
(MiaCall.app on this Mac dials it; the Mac must be awake). Log per call:
~/.mission-control/mia/facetime/<id>.log. The voice on the line is you —
it says the message, listens, and sends what he asks back to you as a chat
line starting "(phone) … [call c_… — answer in the call with: mia call-say …]".
Answer with `mia call-say`; it is spoken in the same call. While a call is live
you can also `mia panel show-doc|show-url` as usual. Each call is capped at
about 5 minutes; 5 calls an hour, 20 a day; no calls 23:00-07:00 (SA time)
unless --urgent. When the call ends you get "(phone) [call c_… ended …]".

The number comes from ~/.mission-control/mia/phone.txt (or --to). The relay
URL and token from MC_RELAY_URL / MC_TOKEN, else the Mission Control app's
Remote settings.
"""
import json
import os
import re
import subprocess
import sys
import urllib.error
import urllib.request

MIA_DIR = os.path.abspath(os.path.expanduser(os.environ.get("MIA_DIR") or "~/.mission-control/mia"))
PHONE_FILE = os.path.join(MIA_DIR, "phone.txt")
# Who may phone Mia (task 0636): phone.txt's number plus this file's lines: numbers
# (+27…), Apple ID emails, or "name:<contact name exactly as FaceTime shows it>".
CALLERS_FILE = os.path.join(MIA_DIR, "phone-callers.txt")


def die(msg, code=1):
    print("mia call: " + msg, file=sys.stderr)
    sys.exit(code)


def defaults(key):
    if os.environ.get("MC_DOC_NO_DEFAULTS") == "1":
        return ""
    try:
        return subprocess.run(["defaults", "read", "com.agentwidget.mission-control", key],
                              capture_output=True, text=True, timeout=5).stdout.strip()
    except Exception:
        return ""


def relay():
    url = (os.environ.get("MC_RELAY_URL") or defaults("remoteURL")).strip().rstrip("/")
    token = (os.environ.get("MC_TOKEN") or defaults("remoteToken")).strip()
    if url.startswith("wss://"):
        url = "https://" + url[6:]
    elif url.startswith("ws://"):
        url = "http://" + url[5:]
    elif url and not url.startswith(("http://", "https://")):
        url = "https://" + url
    if url.endswith("/ws"):
        url = url[:-3]
    if not url or not token:
        die("no relay configured (set MC_RELAY_URL and MC_TOKEN, or the app's Remote settings)")
    return url, token


def call_api(method, path, body=None):
    url, token = relay()
    data = json.dumps(body).encode() if body is not None else None
    req = urllib.request.Request(url + path, data=data, method=method,
                                 headers={"Authorization": "Bearer " + token, "Content-Type": "application/json"})
    try:
        with urllib.request.urlopen(req, timeout=40) as r:
            return r.status, json.loads(r.read() or b"{}")
    except urllib.error.HTTPError as e:
        try:
            return e.code, json.loads(e.read() or b"{}")
        except Exception:
            return e.code, {"ok": False, "error": "HTTP %d" % e.code}
    except Exception as e:
        die("relay unreachable: %s" % e)


def flags(args, names):
    """Split args into positionals and {flag: value|True} for the given names (value flags end in =)."""
    pos, opts, i = [], {}, 0
    while i < len(args):
        a = args[i]
        if a + "=" in names:
            if i + 1 >= len(args):
                die("%s needs a value" % a, 2)
            opts[a] = args[i + 1]
            i += 2
            continue
        if a in names:
            opts[a] = True
        elif a.startswith("--"):
            die("unknown option %s" % a, 2)
        else:
            pos.append(a)
        i += 1
    return pos, opts


def number(opts):
    to = opts.get("--to") or ""
    if not to:
        try:
            to = open(PHONE_FILE).read().strip().splitlines()[0].strip()
        except Exception:
            die("no number: write Daniel's number (+27…) to %s or pass --to" % PHONE_FILE)
    return to.replace(" ", "")


def fail(status, data):
    msg = data.get("error") or ("HTTP %d" % status)
    if data.get("configured") is False:
        miss = ", ".join(data.get("missing") or [])
        msg = "phone calls are not configured on the relay yet" + (" (missing %s)" % miss if miss else "")
    die(msg, 3 if status in (409, 429) else 1)


MIACALL_APP = os.path.expanduser(os.environ.get("MIA_CALL_APP") or "~/Applications/MiaCall.app")


def launch_facetime(call_id, key, to):
    """Hand the call to MiaCall.app (its own Accessibility/audio permissions): it dials
    FaceTime Audio and streams the call to the relay."""
    if not os.path.isdir(MIACALL_APP):
        die("MiaCall.app is not installed (%s) — run scripts/miacall/build.sh" % MIACALL_APP)
    url, _ = relay()
    cmd = ["open", "-n", "-g", MIACALL_APP, "--args", "--call", call_id, "--key", key, "--to", to, "--relay", url]
    if os.environ.get("MIA_CALL_DRY_RUN") == "1":
        print("dry run: " + " ".join(cmd[:-8] + ["--call", call_id, "--key", "…", "--to", to, "--relay", url]), file=sys.stderr)
        return
    r = subprocess.run(cmd, capture_output=True, text=True)
    if r.returncode != 0:
        die("could not start MiaCall: %s" % (r.stderr.strip() or r.returncode))


def cmd_call(args):
    pos, o = flags(args, {"--urgent", "--reason=", "--to=", "--twilio"})
    msg = " ".join(pos).strip()
    if not msg:
        die('usage: mia call "<why you are calling>" [--urgent] [--reason "<background>"] [--to +27…]', 2)
    body = {"to": number(o), "message": msg, "urgent": bool(o.get("--urgent"))}
    if o.get("--reason"):
        body["reason"] = o["--reason"]
    body["via"] = "twilio" if o.get("--twilio") else "facetime"
    status, data = call_api("POST", "/phone/call", body)
    if status != 200 or not data.get("ok"):
        fail(status, data)
    if data.get("via") == "facetime":
        launch_facetime(data["id"], data["key"], body["to"])
    print(data["id"])
    print("ringing Daniel; his words arrive as \"(phone) …\" messages — answer with: mia call-say %s \"…\"" % data["id"], file=sys.stderr)


def allowed_callers():
    nums, emails, names = set(), set(), set()
    lines = []
    for f in (PHONE_FILE, CALLERS_FILE):
        try:
            lines += open(f).read().splitlines()
        except Exception:
            pass
    for raw in lines:
        l = raw.split("#", 1)[0].strip()
        if not l:
            continue
        if l.lower().startswith("name:"):
            n = l[5:].strip().lower()
            if n:
                names.add(n)
        elif "@" in l:
            emails.add(l.lower())
        else:
            d = re.sub(r"\D", "", l)
            if len(d) >= 9:
                nums.add(d[-9:])
    return nums, emails, names


BIDI = re.compile("[\u200e\u200f\u202a-\u202e\u2066-\u2069]")


def caller_matches(label):
    """Is this caller (the text of FaceTime's incoming-call notification) Daniel?
    Numbers match on their last 9 digits, emails exactly, names as a whole comma part."""
    nums, emails, names = allowed_callers()
    t = BIDI.sub("", label or "")
    email_rx = r"[\w.+-]+@[\w-]+(?:\.[\w-]+)+"
    for e in re.findall(email_rx, t):
        if e.lower() in emails:
            return True
    t = re.sub(email_rx, " ", t)  # digits inside someone's email are not his number
    for m in re.findall(r"\+?\d[\d\s().-]{7,}\d", t):
        d = re.sub(r"\D", "", m)
        if len(d) >= 9 and d[-9:] in nums:
            return True
    parts = [p.strip().lower() for p in re.split(r"[,\n]", t)]
    return any(p in names for p in parts if p)


def cmd_incoming(args):
    """MiaCall --listen saw an incoming FaceTime call. Always prints one JSON line."""
    _, o = flags(args, {"--from="})
    label = o.get("--from") or ""
    def out(obj, code=0):
        print(json.dumps(obj))
        sys.exit(code)
    if not caller_matches(label):
        out({"ok": False, "ignore": True, "reason": "not Daniel"}, 4)
    try:
        url, _ = relay()
    except SystemExit:
        out({"ok": False, "error": "no relay configured", "line": "Sorry Daniel, my voice line is down right now. Text me instead."}, 1)
    try:
        status, data = call_api("POST", "/phone/incoming", {"from": "Daniel", "via": "facetime"})
    except SystemExit:
        out({"ok": False, "error": "relay unreachable", "line": "Sorry Daniel, my voice line is down right now. Text me instead."}, 1)
    if status == 200 and data.get("ok"):
        out({"ok": True, "id": data["id"], "key": data["key"], "relay": url})
    if data.get("configured") is False:
        data.setdefault("line", "Sorry Daniel, my voice line isn't set up. Text me instead.")
    res = {"ok": False, "status": status, "error": data.get("error") or ("HTTP %d" % status)}
    for k in ("line", "ignore", "voice", "id"):
        if k in data:
            res[k] = data[k]
    if "line" not in res and not res.get("ignore"):
        res["line"] = "Sorry Daniel, my voice line isn't working right now. Text me instead."
    out(res, 3)


def cmd_say(args):
    pos, o = flags(args, {"--hangup"})
    if len(pos) < 2:
        die('usage: mia call-say <call_id> "<text>" [--hangup]', 2)
    status, data = call_api("POST", "/phone/say", {"id": pos[0], "text": " ".join(pos[1:]), "hangup": bool(o.get("--hangup"))})
    if status != 200 or not data.get("ok"):
        fail(status, data)
    print("%s: %s" % (data.get("id"), data.get("status", "ok")))


def cmd_hangup(args):
    if len(args) != 1:
        die("usage: mia call-hangup <call_id>", 2)
    status, data = call_api("POST", "/phone/hangup", {"id": args[0]})
    if status != 200 or not data.get("ok"):
        fail(status, data)
    print("%s: hung up" % data.get("id"))


def cmd_status(args):
    status, data = call_api("GET", "/phone")
    if "--json" in args:
        print(json.dumps(data, indent=2))
        return
    if data.get("configured") is False:
        print("phone: not configured (missing %s)" % ", ".join(data.get("missing") or []))
        return
    if status != 200:
        fail(status, data)
    lim = data.get("limits", {})
    print("phone: ready · live: %s · last 24h: %d calls, %s min, $%s" % (
        ", ".join(data.get("live") or []) or "none", data["last24h"]["calls"], data["last24h"]["minutes"], data["last24h"]["usd"]))
    print("limits: %s/h, %s/day, %ss per call, quiet %s" % (lim.get("perHour"), lim.get("perDay"), lim.get("maxSeconds"), lim.get("quietHours")))
    for c in data.get("calls", [])[-8:]:
        print("  %s  %s  %-10s %4ss  %s%s" % (c["id"], c["at"][:16].replace("T", " "), c["status"], c.get("seconds", 0),
                                           "URGENT " if c.get("urgent") else "", (c.get("message") or "")[:60]))


def main(argv):
    if not argv or argv[0] in ("help", "-h", "--help"):
        print(__doc__.strip())
        return
    if len(argv) > 1 and argv[1] in ("help", "-h", "--help"):
        print(__doc__.strip())
        return
    table = {"call": cmd_call, "say": cmd_say, "call-say": cmd_say, "hangup": cmd_hangup, "call-hangup": cmd_hangup,
             "status": cmd_status, "call-status": cmd_status, "incoming": cmd_incoming, "call-incoming": cmd_incoming}
    if argv[0] not in table:
        die("unknown command %s (try: mia-phone help)" % argv[0], 2)
    table[argv[0]](argv[1:])


if __name__ == "__main__":
    main(sys.argv[1:])
